{
  "manifest_version": 3,
  "name": "TaksCheck",
  "version": "0.1.0",
  "description": "Estimate the Belgian car tax on any car ad: BIV / TMC and Rijtaks / TC, Flanders, in NL or FR. Not an official assessment.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TaksCheck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "*://*.autoscout24.be/*",
    "*://*.autoscout24.de/*",
    "*://*.autoscout24.nl/*",
    "*://*.autoscout24.fr/*",
    "*://*.autoscout24.lu/*",
    "*://*.mobile.de/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.autoscout24.be/*",
        "*://*.autoscout24.de/*",
        "*://*.autoscout24.nl/*",
        "*://*.autoscout24.fr/*",
        "*://*.autoscout24.lu/*"
      ],
      "js": [
        "core/tax.js",
        "core/normalise.js",
        "ui/badge.js",
        "content/autoscout24.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.mobile.de/*"
      ],
      "js": [
        "core/tax.js",
        "core/normalise.js",
        "ui/badge.js",
        "content/mobilede.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core/tariffs.json",
        "fonts/IBMPlexMono-SemiBold.woff2",
        "fonts/IBMPlexMono-Bold.woff2"
      ],
      "matches": [
        "*://*.autoscout24.be/*",
        "*://*.autoscout24.de/*",
        "*://*.autoscout24.nl/*",
        "*://*.autoscout24.fr/*",
        "*://*.autoscout24.lu/*",
        "*://*.mobile.de/*"
      ]
    }
  ],
  "options_page": "options.html"
}
